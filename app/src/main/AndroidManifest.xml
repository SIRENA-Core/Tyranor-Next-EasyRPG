<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <!-- OpenGL ES 2.0 -->
    <uses-feature android:glEsVersion="0x00020000" />
    <!-- Touchscreen & controller support -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.type.pc"
        android:required="false" />

    <!-- Direct filesystem access for games & saves passed by TyranorNext -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!-- Controller / haptics permissions preserved from upstream EasyRPG Player -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/tyn_easyrpg_app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">

        <!-- SDL3 environment hints -->
        <meta-data
            android:name="SDL_ENV.SDL_ACCELEROMETER_AS_JOYSTICK"
            android:value="0" />
        <meta-data
            android:name="SDL_ENV.SDL_APP_NAME"
            android:value="EasyRPG Player" />
        <meta-data
            android:name="SDL_ENV.SDL_ANDROID_ALLOW_RECREATE_ACTIVITY"
            android:value="1" />

        <!-- Headless launcher entry invoked by TyranorNext (no MAIN/LAUNCHER icon) -->
        <activity
            android:name="com.tyranor.next.easyrpg.LaunchActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="com.tyranor.next.easyrpg.action.RUN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- EasyRPG SDL3 Player Activity subclass -->
        <activity
            android:name="com.tyranor.next.easyrpg.TynEasyRpgPlayerActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:preferMinimalPostProcessing="true"
            android:theme="@style/AppThemePlayerActivity"
            tools:targetApi="r" />

        <!-- Upstream layout editor & settings activities used by the in-game drawer -->
        <activity
            android:name="org.easyrpg.player.button_mapping.ButtonMappingActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="org.easyrpg.player.settings.SettingsMainActivity"
            android:exported="false"
            android:label="@string/settings" />
        <activity
            android:name="org.easyrpg.player.settings.SettingsVideoActivity"
            android:exported="false"
            android:label="@string/video"
            android:parentActivityName="org.easyrpg.player.settings.SettingsMainActivity" />
        <activity
            android:name="org.easyrpg.player.settings.SettingsAudioActivity"
            android:exported="false"
            android:label="@string/audio"
            android:parentActivityName="org.easyrpg.player.settings.SettingsMainActivity" />
        <activity
            android:name="org.easyrpg.player.settings.SettingsGamesFolderActivity"
            android:exported="false"
            android:label="@string/easyrpg_folders"
            android:parentActivityName="org.easyrpg.player.settings.SettingsMainActivity" />
        <activity
            android:name="org.easyrpg.player.settings.SettingsInputActivity"
            android:exported="false"
            android:label="@string/input"
            android:parentActivityName="org.easyrpg.player.settings.SettingsMainActivity" />
        <activity
            android:name="org.easyrpg.player.settings.SettingsFontActivity"
            android:exported="false"
            android:label="@string/font"
            android:parentActivityName="org.easyrpg.player.settings.SettingsMainActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
